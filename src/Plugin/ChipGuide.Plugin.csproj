<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AstralPartyChipGuide</AssemblyName>
    <RootNamespace>ChipGuide.Plugin</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.3.1</Version>
    <PluginDeployDir>$(BepInExDir)\plugins\AstralPartyChipGuide</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ChipGuide.Core.csproj" />
    <EmbeddedResource Include="..\..\rules\rules.json" LogicalName="ChipGuide.rules.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(BepInExDir)\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BepInExDir)\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BepInExDir)\interop\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="RequireBepInExDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(BepInExDir)\core\BepInEx.Core.dll')">
    <Error Text="BepInEx 폴더를 찾지 못했습니다. Directory.Build.local.props.example을 Directory.Build.local.props로 복사해 BepInExDir을 게임의 BepInEx 폴더로 고치거나, 환경 변수 ASTRAL_PARTY_BEPINEX를 설정하세요. (현재 값: '$(BepInExDir)')" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)ChipGuide.Core.dll" DestinationFolder="$(PluginDeployDir)" />
  </Target>
</Project>
